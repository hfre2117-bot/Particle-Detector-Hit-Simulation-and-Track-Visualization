# Reconstruction of the Higgs Boson Signal via Invariant Mass Analysis
# Project Motivation
The discovery of the Higgs boson relies on identifying resonance peaks in invariant mass distributions of its decay products.
This project demonstrates how Higgs-like signals can be reconstructed from simulated collision data using statistical and computational tools common in High Energy Physics.
import numpy as np

def invariant_mass(E1, px1, py1, pz1, E2, px2, py2, pz2):
    E = E1 + E2
    px = px1 + px2
    py = py1 + py2
    pz = pz1 + pz2
    return np.sqrt(E**2 - (px**2 + py**2 + pz**2))
import pandas as pd
import matplotlib.pyplot as plt
from invariant_mass import invariant_mass

data = pd.read_csv("data/higgs_events.csv")

masses = invariant_mass(
    data["E1"], data["px1"], data["py1"], data["pz1"],
    data["E2"], data["px2"], data["py2"], data["pz2"]
)

plt.hist(masses, bins=60)
plt.xlabel("Invariant Mass (GeV)")
plt.ylabel("Events")
plt.title("Higgs Candidate Mass Spectrum")
plt.show()
